    function makeElementDraggable(element, tableData) {
      var canvasBox = document.getElementById('editorCanvasBox');

      function onStart(e) {
        if (e.touches && e.touches.length > 1) return;
        e.preventDefault();
        element.classList.add('is-dragging');

        var rect = canvasBox.getBoundingClientRect();
        var clientX = e.touches ? e.touches[0].clientX : e.clientX;
        var clientY = e.touches ? e.touches[0].clientY : e.clientY;

        var currentCanvasX = (tableData.left / 500) * rect.width;
        var currentCanvasY = (tableData.top / 750) * rect.height;

        var startTouchX = clientX - rect.left;
        var startTouchY = clientY - rect.top;

        var offsetX = startTouchX - currentCanvasX;
        var offsetY = startTouchY - currentCanvasY;

        function onMove(moveEvent) {
          moveEvent.preventDefault();
          var moveClientX = moveEvent.touches ? moveEvent.touches[0].clientX : moveEvent.clientX;
          var moveClientY = moveEvent.touches ? moveEvent.touches[0].clientY : moveEvent.clientY;

          var currentRect = canvasBox.getBoundingClientRect();
          var rawX = moveClientX - currentRect.left - offsetX;
          var rawY = moveClientY - currentRect.top - offsetY;

          var posX = Math.round((rawX / currentRect.width) * 500);
          var posY = Math.round((rawY / currentRect.height) * 750);

          posX = Math.max(25, Math.min(475, posX));
          posY = Math.max(25, Math.min(725, posY));

          tableData.left = posX;
          tableData.top = posY;

          element.style.left = ((tableData.left / 500) * 100) + '%';
          element.style.top = ((tableData.top / 750) * 100) + '%';
        }

        function onEnd(endEvent) {
          element.classList.remove('is-dragging');
          window.removeEventListener('mousemove', onMove);
          window.removeEventListener('mouseup', onEnd);
          window.removeEventListener('touchmove', onMove);
          window.removeEventListener('touchend', onEnd);

          saveData();
        }

        window.addEventListener('mousemove', onMove, { passive: false });
        window.addEventListener('mouseup', onEnd);
        window.addEventListener('touchmove', onMove, { passive: false });
        window.addEventListener('touchend', onEnd);
      }

      element.addEventListener('mousedown', onStart);
      element.addEventListener('touchstart', onStart, { passive: false });
    }

