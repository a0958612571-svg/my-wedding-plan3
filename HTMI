<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  
  <title>蘇鴻楷 & 吳亭蓉 婚禮座位查詢系統</title>
  
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;600;700&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  
  <!-- Firebase SDK (v9 模組化) -->
  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
    import { getDatabase, ref, onValue, set } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-database.js";
    import { getAuth, signInWithEmailAndPassword, signOut, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js";

    // ⚠️ 請填入你的 Firebase Config
    const firebaseConfig = {
      apiKey: "YOUR_API_KEY",
      authDomain: "YOUR_PROJECT_ID.firebaseapp.com",
      databaseURL: "https://YOUR_PROJECT_ID-default-rtdb.asia-southeast1.firebasedatabase.app",
      projectId: "YOUR_PROJECT_ID",
      storageBucket: "YOUR_PROJECT_ID.appspot.com",
      messagingSenderId: "YOUR_SENDER_ID",
      appId: "YOUR_APP_ID"
    };

    const app = initializeApp(firebaseConfig);
    const db = getDatabase(app);
    const auth = getAuth(app);
    const dbRef = ref(db, 'wedding_seating');

    window.db = db;
    window.auth = auth;
    window.dbRef = dbRef;

    window.setDatabaseData = (data) => {
      if (!auth.currentUser) {
        alert("請先登入管理員帳號才能儲存變更！");
        return;
      }
      set(dbRef, data).catch((err) => {
        alert("儲存失敗，權限不足或連線問題：" + err.message);
      });
    };

    window.adminLogin = (email, password) => {
      return signInWithEmailAndPassword(auth, email, password);
    };

    window.adminLogout = () => {
      signOut(auth).then(() => {
        alert("已成功登出管理員身分");
      });
    };

    onAuthStateChanged(auth, (user) => {
      const authBox = document.getElementById('adminAuthBox');
      const adminContent = document.getElementById('adminContent');
      const userStatusText = document.getElementById('adminUserStatus');

      if (user) {
        if (authBox) authBox.classList.add('hidden');
        if (adminContent) adminContent.classList.remove('hidden');
        if (userStatusText) userStatusText.innerText = `已登入：${user.email}`;
        if (window.refreshAdminData) window.refreshAdminData();
        if (window.renderEditorMap) window.renderEditorMap();
      } else {
        if (authBox) authBox.classList.remove('hidden');
        if (adminContent) adminContent.classList.add('hidden');
        if (userStatusText) userStatusText.innerText = '';
      }
    });

    onValue(dbRef, (snapshot) => {
      const data = snapshot.val();
      if (data) {
        window.appData = data;
      } else {
        window.appData = window.defaultData;
      }
      if (window.renderFrontend) window.renderFrontend();
      if (window.refreshAdminData && auth.currentUser) window.refreshAdminData();
      if (window.renderEditorMap && auth.currentUser) window.renderEditorMap();
      
      const statusEl = document.getElementById('syncStatus');
      if (statusEl) {
        statusEl.innerText = "🟢 雲端同步中";
        statusEl.className = "text-[10px] text-green-600 font-bold bg-green-50 px-2.5 py-1 rounded-full border border-green-200";
      }
    });
  </script>

  <style>
    html, body {
      width: 100%;
      overflow-x: hidden;
      margin: 0;
      padding: 0;
      user-select: none;
      -webkit-user-select: none;
      touch-action: manipulation;
    }

    body {
      font-family: 'Plus Jakarta Sans', 'Noto Serif TC', -apple-system, sans-serif;
      background-color: #F8F6F0;
      background-image: radial-gradient(#E5DEC9 1.2px, transparent 1.2px);
      background-size: 20px 20px;
      color: #52473C;
    }

    .font-serif-custom { font-family: 'Noto Serif TC', serif; }
    
    .table-highlight { 
      box-shadow: 0 0 0 6px #B09F8C, 0 12px 24px -4px rgba(176, 159, 140, 0.5); 
      transform: translate(-50%, -50%) scale(1.15) !important;
      z-index: 30 !important;
      animation: tableGlowPulse 1.8s infinite ease-in-out;
    }

    @keyframes tableGlowPulse {
      0% { box-shadow: 0 0 0 0px rgba(176, 159, 140, 0.8), 0 8px 16px rgba(0,0,0,0.1); }
      50% { box-shadow: 0 0 0 18px rgba(176, 159, 140, 0), 0 12px 24px rgba(176, 159, 140, 0.4); }
      100% { box-shadow: 0 0 0 0px rgba(176, 159, 140, 0), 0 8px 16px rgba(0,0,0,0.1); }
    }

    /* 強制設定完美正圓形與尺寸，防止文字撐開變形 */
    .table-circle-item {
      width: 72px !important;
      height: 72px !important;
      min-width: 72px !important;
      min-height: 72px !important;
      border-radius: 50% !important;
      transform: translate(-50%, -50%);
      touch-action: none !important;
      -webkit-user-drag: none;
      box-sizing: border-box;
      will-change: left, top;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      overflow: hidden;
    }

    @media (min-width: 640px) {
      .table-circle-item {
        width: 84px !important;
        height: 84px !important;
        min-width: 84px !important;
        min-height: 84px !important;
      }
    }

    .is-dragging {
      z-index: 50 !important;
      border-color: #52473C !important;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3) !important;
      opacity: 0.9;
      transform: translate(-50%, -50%) scale(1.08) !important;
      transition: transform 0.05s ease;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col items-center justify-between p-3 sm:p-8">

  <!-- 頂部導覽列 -->
  <header class="w-full max-w-5xl flex justify-between items-center mb-4 sm:mb-6 pt-2 px-2">
    <div class="flex items-center space-x-2">
      <span class="w-2.5 h-2.5 rounded-full bg-[#E5DEC9]"></span>
      <span class="text-xs font-bold tracking-widest text-[#A39281] uppercase">GUEST PORTAL</span>
      <span id="syncStatus" class="text-[10px] text-amber-600 font-bold bg-amber-50 px-2.5 py-1 rounded-full border border-amber-200">🟡 連線中...</span>
    </div>
    <button onclick="toggleAdminMode()" id="topToggleText" class="px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-xl text-xs font-bold bg-[#52473C] text-white hover:bg-[#3D342C] transition shadow-md flex items-center gap-1.5 cursor-pointer">
      <span>⚙️</span> 後台管理
    </button>
  </header>

  <main class="w-full max-w-5xl flex flex-col items-center">

    <!-- 前台畫面 -->
    <div id="frontendView" class="w-full flex flex-col items-center space-y-5 sm:space-y-6">
      
      <div class="text-center space-y-1.5 sm:space-y-2">
        <span class="px-3 py-1 rounded-full bg-white/80 border border-[#ECE4DA] text-[10px] sm:text-[11px] text-[#A39281] tracking-widest inline-block">WEDDING SEATING CHART</span>
        <h1 class="text-2xl sm:text-4xl font-serif-custom font-bold text-[#52473C] tracking-wide mt-1">
          <span id="displayGroom">蘇鴻楷</span> <span class="text-[#A39281] font-normal">&</span> <span id="displayBride">吳亭蓉</span>
        </h1>
        <p class="text-xs text-[#A39281] tracking-wider">誠摯邀請您 參與我們的幸福時刻</p>
      </div>

      <div class="w-full bg-white/70 backdrop-blur-md rounded-2xl sm:rounded-3xl p-3 sm:p-6 border border-[#ECE4DA] shadow-sm grid grid-cols-3 gap-1 sm:gap-2 text-center text-xs">
        <div class="space-y-0.5 sm:space-y-1">
          <p class="text-[10px] sm:text-[11px] text-[#A39281]">宴客日期</p>
          <p id="displayDateTime" class="font-bold text-[#52473C] text-xs sm:text-base">2026.11.07(六)</p>
        </div>
        <div class="space-y-0.5 sm:space-y-1 border-x border-[#ECE4DA]">
          <p class="text-[10px] sm:text-[11px] text-[#A39281]">📍 宴客地點</p>
          <p id="displayLocation" class="font-bold text-[#52473C] text-xs sm:text-base">台南晶英酒店2樓</p>
        </div>
        <div class="space-y-0.5 sm:space-y-1">
          <p class="text-[10px] sm:text-[11px] text-[#A39281]">🥂 宴會廳別</p>
          <p id="displayHall" class="font-bold text-[#52473C] text-xs sm:text-base">明倫仁德廳</p>
        </div>
      </div>

      <!-- 搜尋區塊 -->
      <div class="w-full bg-white/70 backdrop-blur-md rounded-2xl sm:rounded-3xl p-4 border border-[#ECE4DA] shadow-sm flex flex-col items-center space-y-2">
        <p class="text-xs text-[#8C7A6B]">請輸入您的「賓客姓名」快速查詢席位桌號</p>
        <div class="relative w-full max-w-md">
          <input type="text" id="frontendSearchInput" oninput="handleSearchLive()" onkeydown="if(event.key==='Enter') handleSearch()" placeholder="例如：蘇鴻楷、吳亭蓉..." class="w-full px-5 py-2.5 sm:py-3 rounded-full bg-white border border-[#ECE4DA] text-xs focus:outline-none focus:ring-2 focus:ring-[#B09F8C] shadow-inner text-[#52473C]">
          <button onclick="handleSearch()" class="absolute right-2 top-1.5 sm:top-2 px-3 py-1 sm:py-1.5 bg-[#B09F8C] text-white rounded-full text-xs font-bold hover:opacity-90 transition cursor-pointer">搜尋</button>
          
          <div id="searchDropdown" class="hidden absolute left-0 right-0 top-12 bg-white border border-[#ECE4DA] rounded-2xl shadow-xl z-30 max-h-48 overflow-y-auto"></div>
        </div>
      </div>

      <!-- 宴會區域 -->
      <div class="w-full bg-white/70 backdrop-blur-md rounded-2xl sm:rounded-3xl p-3 sm:p-6 border border-[#ECE4DA] shadow-sm flex flex-col items-center relative min-h-[500px]">
        <div class="mb-4 sm:mb-6 px-6 py-1.5 sm:px-8 sm:py-2 rounded-full bg-[#EFE8DF] border border-[#ECE4DA] text-xs font-bold text-[#786A5C] tracking-wider shadow-xs">
          ◆ 主 舞 臺 ◆ (STAGE)
        </div>

        <div class="relative w-full max-w-[500px] aspect-[5/7.5] bg-white rounded-2xl sm:rounded-3xl border border-[#ECE4DA] shadow-inner overflow-hidden mx-auto">
          <svg id="frontendCarpetSvg" class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 500 750" preserveAspectRatio="xMidYMin meet"></svg>
          <div id="frontendNodesContainer" class="absolute inset-0 w-full h-full"></div>
        </div>
      </div>

    </div>

    <!-- 後台畫面 -->
    <div id="adminView" class="hidden w-full flex flex-col space-y-6">
      
      <!-- 安全驗證 (Firebase Auth 登入框) -->
      <div id="adminAuthBox" class="w-full bg-white/90 backdrop-blur-md rounded-3xl p-8 sm:p-10 border border-[#ECE4DA] shadow-lg flex flex-col items-center justify-center space-y-4">
        <div class="w-12 h-12 rounded-full bg-[#F5EFE6] flex items-center justify-center text-xl">🛡️</div>
        <h3 class="text-sm font-bold text-[#52473C]">管理員安全登入 (Firebase Auth)</h3>
        <p class="text-xs text-[#A39281] text-center">請輸入在 Firebase 控制台建立的管理者帳號密碼</p>
        <input type="email" id="adminEmailInput" placeholder="管理員 Email" class="px-4 py-2 border border-[#ECE4DA] rounded-xl text-xs text-center focus:outline-none w-64">
        <input type="password" id="adminPasswordInput" placeholder="密碼" onkeydown="if(event.key==='Enter') executeAdminLogin()" class="px-4 py-2 border border-[#ECE4DA] rounded-xl text-xs text-center focus:outline-none w-64">
        <button onclick="executeAdminLogin()" class="px-6 py-2 bg-[#B09F8C] text-white rounded-xl text-xs font-bold hover:opacity-90 transition cursor-pointer">登入後台</button>
      </div>

      <!-- 後台管理控制台 -->
      <div id="adminContent" class="hidden flex flex-col space-y-6">
        
        <div class="bg-[#F9F7F2]/80 border border-[#ECE4DA] rounded-3xl p-6 shadow-sm flex justify-between items-center">
          <div>
            <h1 class="text-lg font-bold text-[#52473C] flex items-center gap-2">
              <span>⚙️</span> 婚禮控制中心 & 後台管理系統
            </h1>
            <p id="adminUserStatus" class="text-xs text-[#A39281] mt-0.5 font-mono"></p>
          </div>
          <div class="flex gap-2">
            <button onclick="exportGuestCSV()" class="px-3.5 py-2 bg-white border border-[#ECE4DA] rounded-xl text-xs text-[#786A5C] hover:bg-[#F5EFE6] transition shadow-xs cursor-pointer">📄 匯出 CSV</button>
            <button onclick="window.adminLogout()" class="px-3.5 py-2 bg-red-50 text-red-500 hover:bg-red-100 rounded-xl text-xs font-bold transition cursor-pointer">登出</button>
          </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="bg-white border border-[#ECE4DA] rounded-2xl p-4 shadow-xs">
            <p class="text-[11px] text-[#A39281]">總桌數</p>
            <p class="text-2xl font-bold text-[#52473C] mt-1"><span id="statTotalTables">0</span> <span class="text-xs font-normal text-[#A39281]">桌</span></p>
          </div>
          <div class="bg-white border border-[#ECE4DA] rounded-2xl p-4 shadow-xs">
            <p class="text-[11px] text-[#A39281]">總賓客人數</p>
            <p class="text-2xl font-bold text-[#52473C] mt-1"><span id="statTotalGuests">0</span> <span class="text-xs font-normal text-[#A39281]">人</span></p>
          </div>
          <div class="bg-white border border-[#ECE4DA] rounded-2xl p-4 shadow-xs">
            <p class="text-[11px] text-[#A39281]">目前新人</p>
            <p id="statCoupleNames" class="text-sm font-bold text-[#52473C] mt-2 truncate">-- & --</p>
          </div>
          <div class="bg-white border border-[#ECE4DA] rounded-2xl p-4 shadow-xs">
            <p class="text-[11px] text-[#A39281]">宴客日期</p>
            <p id="statWeddingDate" class="text-sm font-bold text-[#52473C] mt-2 truncate">----.--.--</p>
          </div>
        </div>

        <!-- 分頁標籤 -->
        <div class="flex space-x-2 sm:space-x-3 border-b border-[#ECE4DA] pb-2 overflow-x-auto">
          <button onclick="switchAdminTab('tables')" id="tabBtn-tables" class="px-4 sm:px-5 py-2 rounded-full text-xs font-bold bg-[#A39281] text-white flex items-center gap-1.5 shadow-xs cursor-pointer whitespace-nowrap">
            <span>🎎</span> 桌次與賓客
          </button>
          <button onclick="switchAdminTab('canvas')" id="tabBtn-canvas" class="px-4 sm:px-5 py-2 rounded-full text-xs text-[#786A5C] hover:bg-[#EFE8DF] flex items-center gap-1.5 transition cursor-pointer whitespace-nowrap">
            <span>🎨</span> 編輯平面圖與紅毯
          </button>
          <button onclick="switchAdminTab('info')" id="tabBtn-info" class="px-4 sm:px-5 py-2 rounded-full text-xs text-[#786A5C] hover:bg-[#EFE8DF] flex items-center gap-1.5 transition cursor-pointer whitespace-nowrap">
            <span>♥</span> 婚禮資訊
          </button>
        </div>

        <!-- 頁籤：桌次與賓客 -->
        <div id="tab-tables" class="space-y-6">
          <div class="bg-[#F9F7F2]/80 border border-[#ECE4DA] rounded-3xl p-6 shadow-sm space-y-4">
            <h2 class="text-sm font-bold text-[#52473C] flex items-center gap-1.5">
              <span>👨‍👩‍👧‍👦</span> 新增桌次
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-4 gap-3">
              <div>
                <label class="text-[11px] text-[#A39281] block mb-1">桌號代碼 *</label>
                <input type="text" id="addTableCode" placeholder="例如：T10" class="w-full p-2.5 bg-white border border-[#ECE4DA] rounded-xl text-xs focus:outline-none">
              </div>
              <div>
                <label class="text-[11px] text-[#A39281] block mb-1">桌次名稱 *</label>
                <input type="text" id="addTableName" placeholder="例如：男方大學同學桌" class="w-full p-2.5 bg-white border border-[#ECE4DA] rounded-xl text-xs focus:outline-none">
              </div>
              <div>
                <label class="text-[11px] text-[#A39281] block mb-1">分類屬性</label>
                <input type="text" id="addTableCategory" placeholder="例如：高中好友" class="w-full p-2.5 bg-white border border-[#ECE4DA] rounded-xl text-xs focus:outline-none">
              </div>
              <div class="flex items-end">
                <button onclick="addNewTable()" class="w-full py-2.5 bg-[#A39281] text-white rounded-xl text-xs font-bold hover:bg-[#8C7A6B] transition cursor-pointer">新增桌次</button>
              </div>
            </div>

            <div id="adminTableCardGrid" class="grid grid-cols-1 md:grid-cols-2 gap-3 pt-2"></div>
          </div>

          <div class="bg-[#F9F7F2]/80 border border-[#ECE4DA] rounded-3xl p-6 shadow-sm space-y-4">
            <h2 class="text-sm font-bold text-[#52473C] flex items-center gap-1.5">
              <span>👤</span> 新增單筆賓客
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-4 gap-3">
              <div>
                <label class="text-[11px] text-[#A39281] block mb-1">賓客姓名 *</label>
                <input type="text" id="addGuestName" placeholder="例如：李小華" class="w-full p-2.5 bg-white border border-[#ECE4DA] rounded-xl text-xs focus:outline-none">
              </div>
              <div>
                <label class="text-[11px] text-[#A39281] block mb-1">分配席位桌號 *</label>
                <select id="addGuestTableSelect" class="w-full p-2.5 bg-white border border-[#ECE4DA] rounded-xl text-xs focus:outline-none"></select>
              </div>
              <div>
                <label class="text-[11px] text-[#A39281] block mb-1">個人備註</label>
                <input type="text" id="addGuestNote" placeholder="例如：蛋奶素" class="w-full p-2.5 bg-white border border-[#ECE4DA] rounded-xl text-xs focus:outline-none">
              </div>
              <div class="flex items-end">
                <button onclick="addNewGuest()" class="w-full py-2.5 bg-[#A39281] text-white rounded-xl text-xs font-bold hover:bg-[#8C7A6B] transition cursor-pointer">確定新增</button>
              </div>
            </div>

            <div class="mt-4 border border-[#ECE4DA] rounded-2xl bg-white overflow-x-auto">
              <table class="w-full text-xs text-left min-w-[400px]">
                <thead class="bg-[#F9F7F2] text-[#A39281] border-b border-[#ECE4DA]">
                  <tr>
                    <th class="p-3">姓名</th>
                    <th class="p-3">安排桌次</th>
                    <th class="p-3">備註</th>
                    <th class="p-3 text-right">操作</th>
                  </tr>
                </thead>
                <tbody id="adminGuestTableBody"></tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- 頁籤：編輯平面圖與紅毯 -->
        <div id="tab-canvas" class="hidden bg-[#F9F7F2]/80 border border-[#ECE4DA] rounded-3xl p-6 shadow-sm space-y-6">
          <div class="flex justify-between items-center">
            <h2 class="text-sm font-bold text-[#52473C] flex items-center gap-2">
              <span>🎨</span> 調整桌位 (按住拖曳桌子) 與 L 型紅毯控制
            </h2>
            <button onclick="saveCanvasLayout()" class="px-5 py-2 bg-[#A39281] text-white rounded-xl text-xs font-bold hover:bg-[#8C7A6B] transition shadow-xs flex items-center gap-1.5 cursor-pointer">
              <span>💾</span> 儲存同步至雲端
            </button>
          </div>

          <div class="bg-white border border-[#ECE4DA] rounded-2xl p-4 shadow-xs space-y-3">
            <h3 class="text-xs font-bold text-[#786A5C] flex items-center gap-1.5">
              <span>📐</span> L 型紅毯座標設定：
            </h3>
            <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-5 gap-3 items-end">
              <div>
                <label class="text-[10px] text-[#A39281] block mb-1">起點 (X1, Y1)</label>
                <div class="flex gap-1">
                  <input type="number" id="carpetX1" class="w-1/2 p-2 bg-[#F9F7F2] border border-[#ECE4DA] rounded-lg text-xs text-center">
                  <input type="number" id="carpetY1" class="w-1/2 p-2 bg-[#F9F7F2] border border-[#ECE4DA] rounded-lg text-xs text-center">
                </div>
              </div>
              <div>
                <label class="text-[10px] text-[#A39281] block mb-1">折點 (X2, Y2)</label>
                <div class="flex gap-1">
                  <input type="number" id="carpetX2" class="w-1/2 p-2 bg-[#F9F7F2] border border-[#ECE4DA] rounded-lg text-xs text-center">
                  <input type="number" id="carpetY2" class="w-1/2 p-2 bg-[#F9F7F2] border border-[#ECE4DA] rounded-lg text-xs text-center">
                </div>
              </div>
              <div>
                <label class="text-[10px] text-[#A39281] block mb-1">終點 (X3, Y3)</label>
                <div class="flex gap-1">
                  <input type="number" id="carpetX3" class="w-1/2 p-2 bg-[#F9F7F2] border border-[#ECE4DA] rounded-lg text-xs text-center">
                  <input type="number" id="carpetY3" class="w-1/2 p-2 bg-[#F9F7F2] border border-[#ECE4DA] rounded-lg text-xs text-center">
                </div>
              </div>
              <div>
                <label class="text-[10px] text-[#A39281] block mb-1">寬度 (Width)</label>
